# Copy this file to .env.local for local development and fill in the values.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# NEVER put real values in this file; it is committed to GitHub.

# --- Required on Vercel ---------------------------------------------------
# Your AI key (OpenRouter, starts with sk-or-v1-).
OPENROUTER_API_KEY=paste_your_key_here
# A long random string that signs login cookies. Make one with:  openssl rand -base64 32
SESSION_SECRET=paste_a_long_random_string_here
# Postgres connection string. Vercel fills this in for you when you add a Neon database
# (Project -> Storage -> Create Database -> Neon). Leave it empty locally (an embedded database is used).
DATABASE_URL=

# --- Needed for the daily comeback job ------------------------------------
# Any long random string. Vercel Cron sends it to prove a request is really from Vercel.
CRON_SECRET=

# --- Optional -------------------------------------------------------------
AI_MODEL=google/gemini-3.8-flash
# Set to 1 to show the demo tools (pretend 3 days passed, add history) on a live site.
ALLOW_DEMO_TOOLS=
# How many sign-ups one network may make per hour (default 8). Raise it for a demo day or for testing.
SIGNUP_LIMIT_PER_HOUR=
